# Token do bot (Discord Developer Portal -> Bot)
DISCORD_TOKEN=

# Application ID do bot (Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID=

# ID do servidor (guild) para testes de comandos
DISCORD_GUILD_ID=

# Nível de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Ativa logs detalhados do handshake de voz (opcional)
VOICE_DEBUG=false
